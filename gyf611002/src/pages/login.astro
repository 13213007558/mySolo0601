---
import { USERS } from '../data/users';
const accounts = USERS.map(u => ({
  username: u.username,
  passwordHint: u.password,
  roleLabel: u.role === 'checker' ? '检录员' : '教练',
  displayName: u.displayName
}));
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>登录 · 冰刀刃角采集台</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/orbitron@6.0.0/600.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/jetbrains-mono@6.0.0/400.min.css" />
  </head>
  <body class="grid place-items-center min-h-screen grid-frost">
    <div class="ice-card rounded-sm w-[460px] p-8 relative overflow-hidden">
      <div class="absolute -top-16 -left-16 w-72 h-72 rounded-full bg-ice-400/10 blur-3xl"></div>
      <div class="absolute -bottom-20 -right-16 w-80 h-80 rounded-full bg-ice-600/10 blur-3xl"></div>

      <div class="flex items-center gap-3 mb-6 relative z-10">
        <span class="grid place-items-center w-11 h-11 rounded-sm bg-ice-500/25 border border-ice-400/50 text-frost text-2xl">⛸️</span>
        <div>
          <div class="font-display text-xl text-frost tracking-[0.3em]">BLADE · STATION</div>
          <div class="text-[11px] text-ice-200 tracking-wider mt-0.5">冰刀刃角采集台 · ISU 合规检录</div>
        </div>
      </div>

      <form id="login-form" class="relative z-10 space-y-4">
        <div>
          <label class="block text-xs uppercase tracking-widest text-ice-200 mb-1.5">角色</label>
          <div class="grid grid-cols-2 gap-2">
            <label class="role-card ice-card p-3 rounded-sm cursor-pointer text-center hover:border-ice-400 transition">
              <input type="radio" name="role" value="checker" class="hidden peer" checked />
              <div class="text-2xl mb-1">🧾</div>
              <div class="text-sm text-frost font-semibold">检录员</div>
              <div class="text-[11px] text-ice-300 mt-1">执行刃角采集</div>
              <div class="absolute inset-0 ring-2 ring-ice-400/0 peer-checked:ring-ice-400 rounded-sm pointer-events-none transition"></div>
            </label>
            <label class="role-card ice-card p-3 rounded-sm cursor-pointer text-center hover:border-ice-400 transition relative">
              <input type="radio" name="role" value="coach" class="hidden peer" />
              <div class="text-2xl mb-1">🎽</div>
              <div class="text-sm text-frost font-semibold">教练</div>
              <div class="text-[11px] text-ice-300 mt-1">审核暂缓标签</div>
              <div class="absolute inset-0 ring-2 ring-ice-400/0 peer-checked:ring-ice-400 rounded-sm pointer-events-none transition"></div>
            </label>
          </div>
        </div>
        <div>
          <label class="block text-xs uppercase tracking-widest text-ice-200 mb-1.5">账号</label>
          <input id="username" class="ice-input" autocomplete="username" placeholder="请输入账号" />
        </div>
        <div>
          <label class="block text-xs uppercase tracking-widest text-ice-200 mb-1.5">密码</label>
          <input id="password" type="password" class="ice-input" autocomplete="current-password" placeholder="请输入密码" />
        </div>
        <div id="login-err" class="text-xs text-rose-400 h-5"></div>
        <button type="submit" class="ice-btn w-full justify-center py-2.5">进入采集台</button>
      </form>

      <div class="relative z-10 mt-6 pt-5 border-t border-ice-700/60">
        <div class="text-[11px] text-ice-300 mb-2 uppercase tracking-wider">演示账号</div>
        <div class="grid grid-cols-2 gap-3 text-xs">
          {accounts.map(a => (
            <div class="ice-card p-2.5 rounded-sm">
              <div class="flex items-center gap-1.5">
                <span class="status-chip bg-ice-500/20 border border-ice-400/30 text-ice-200">{a.roleLabel}</span>
                <span class="text-ice-100">{a.displayName}</span>
              </div>
              <div class="text-[11px] text-ice-300 mt-1">
                <span class="text-ice-400">账号</span> {a.username}
                <span class="mx-1.5 text-ice-600">|</span>
                <span class="text-ice-400">密码</span> {a.passwordHint}
              </div>
            </div>
          ))}
        </div>
        <div class="mt-3 text-[11px] text-amber-300/90 flex items-center gap-1.5">
          <span>⚠️</span>合规规则：同一账号<strong>不可</strong>同时兼任检录员与教练
        </div>
      </div>
    </div>

    <script is:inline define:vars={{users:USERS}}>
    (function () {
      const form = document.getElementById('login-form');
      const errEl = document.getElementById('login-err');
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        errEl.textContent = '';
        const role = form.querySelector('input[name="role"]:checked').value;
        const username = document.getElementById('username').value.trim();
        const password = document.getElementById('password').value;
        const u = users.find(x => x.username === username && x.password === password);
        if (!u) { errEl.textContent = '账号或密码错误'; return; }
        if (u.role !== role) {
          const correctRole = u.role === 'checker' ? '检录员' : '教练';
          errEl.textContent = `角色互斥：该账号属于【${correctRole}】，请切换角色`;
          return;
        }
        const session = {
          userId: u.id, username: u.username, displayName: u.displayName,
          role: u.role, loginAt: new Date().toISOString()
        };
        localStorage.setItem('blade-station.auth', JSON.stringify(session));
        location.replace('/dashboard');
      });
    })();
    </script>
  </body>
</html>

<style>
.role-card { position: relative; }
</style>
