---
import '../styles/global.css';
interface Props { title: string; noSessionBar?: boolean; }
const { title, noSessionBar } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title} · 冰刀刃角采集台</title>
  </head>
  <body class="min-h-screen">
    {!noSessionBar && (
    <header class="px-6 py-3 flex items-center gap-6 border-b border-ice-700/60 backdrop-blur-sm bg-ice-950/50 sticky top-0 z-30">
      <a href="/dashboard" class="flex items-center gap-3">
        <span class="grid place-items-center w-9 h-9 rounded-sm bg-ice-500/25 border border-ice-400/40 text-ice-200 text-xl">⛸️</span>
        <span class="font-display text-lg text-frost tracking-widest">BLADE · EDGE · STATION</span>
      </a>
      <nav class="flex items-center gap-1 text-sm">
        <a href="/dashboard" class="ice-btn ice-btn--ghost">检录台</a>
        <a href="/athletes"  class="ice-btn ice-btn--ghost">冰刀档案</a>
        <a href="/export"    class="ice-btn ice-btn--ghost">ISU 导出</a>
        <a href="/calibrate" class="ice-btn ice-btn--ghost">镜头校零</a>
      </nav>
      <div class="ml-auto flex items-center gap-4">
        <div id="user-chip" class="text-xs text-ice-200"></div>
        <button id="logout-btn" class="ice-btn ice-btn--ghost">退出登录</button>
      </div>
    </header>
    )}
    <main class="min-h-[calc(100vh-64px)]">
      <slot />
    </main>
  </body>
  {!noSessionBar && (
    <script is:inline define:vars={{}}>
    (function () {
      try {
        const raw = localStorage.getItem('blade-station.auth');
        const chip = document.getElementById('user-chip');
        const logout = document.getElementById('logout-btn');
        if (raw) {
          const s = JSON.parse(raw);
          const roleLabel = s.role === 'checker' ? '检录员' : '教练';
          chip.textContent = `【${roleLabel}】${s.displayName} · 登录 ${new Date(s.loginAt).toLocaleTimeString('zh-CN')}`;
        } else {
          location.replace('/login');
          return;
        }
        logout.addEventListener('click', () => {
          localStorage.removeItem('blade-station.auth');
          location.replace('/login');
        });
      } catch (e) { location.replace('/login'); }
    })();
    </script>
  )}
</html>
